# LLM Wiki — Environment variables template
# Copy this file to `.env` and fill in your actual values.
# These variables are consumed by `llm_wiki.config.settings` (Pydantic Settings).
# In Kubernetes, equivalent values are injected via `k8s/configmap.yaml` and `k8s/secret.yaml`.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wiki:PASSWORD@localhost:5432/llm_wiki

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hieunt
MINIO_SECRET_KEY=PASSWORD

# ── Ollama (embeddings + optional local LLM) ──────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Redis / Valkey ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── External data sources ─────────────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_KEY
RAPIDAPI_KEY=YOUR_KEY

# ── Telegram bot (optional) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
ALLOWED_TELEGRAM_CHAT_IDS=

# ── LLM provider configuration ────────────────────────────────────────────────
# LLM_PROVIDER: auto | opencode | gemini
LLM_PROVIDER=auto

OPENCODE_API_KEY=YOUR_KEY
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_PRIMARY_MODEL=deepseek-v4-flash
OPENCODE_FALLBACK_MODEL=deepseek-v4-flash
OPENCODE_CHAT_MODEL=deepseek-v4-flash

GEMINI_API_KEY=YOUR_KEY
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ── Feature flags ─────────────────────────────────────────────────────────────
RERANKER_ENABLED=false

# ── Kubernetes / worker specific (not used by the backend directly) ───────────
# The variables below are referenced only by K8s manifests and worker entrypoints.
# You do not need them for plain local backend development.
# TZ=Asia/Ho_Chi_Minh
# HOSTNAME=0.0.0.0
# CPU_MAX_PERCENT=85
# RAPIDAPI_RPS=1
# NEXT_PUBLIC_API_URL=/api
