[bandit]
# B101: assert in tests is expected
# B311: random is not used for security
# B404: subprocess with user input — pre-existing, mitigated via input validation
# B603: subprocess without shell=True — no shell injection risk
# B607: partial path in subprocess — resolvable, pre-existing
# B608: SQL injection — ALL false positive (SQLAlchemy text() + param binding)
skips = B101,B311,B404,B603,B607,B608
exclude = tests/,frontend/,migrations/
